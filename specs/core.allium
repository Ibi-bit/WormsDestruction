-- allium: 3
-- core.allium

-- Scope: Scene lifecycle and frame progression for the game loop
-- Includes: Scene, SceneManager (registration, queued switches, restart), per-frame ordering
-- Excludes:
--   - Window, audio and ImGui setup/teardown (Raylib/rlImGui infrastructure)
--   - Window and settings values (title, size, FPS, vsync, resizable, maximised, debug window): configuration, not domain
--   - Config file persistence (path, JSON format, rewrite on load): infrastructure
--   - Screenshot capture, both the test hook and the debug shortcut: tooling
--   - Debug UI widgets: tooling
--   - Maximise-after-first-frame: workaround for window manager behaviour; underlying need is "window starts maximised"
--   - The concrete scenes (title, gameplay, pause, settings): specified in their own specs

entity Scene {
    status: unloaded | active | inactive
}

entity SceneManager {
    current: Scene?
    pending: Scene?
}

-- Scene lifecycle

rule GameStarted {
    when: GameStarted()

    ensures: SceneManager.pending = GameScene
    ensures: SceneManager.current = GameScene
    ensures: GameScene.status = active
}

rule SceneSwitchRequested {
    when: ChangeScene(target)

    ensures: SceneManager.pending = target
}

rule RestartCurrentScene {
    when: RestartCurrent()
    requires: SceneManager.current != null

    -- The cached instance is discarded; the next activation builds a fresh one
    ensures: SceneManager.current.status = unloaded
    ensures: SceneManager.pending = SceneManager.current
}

rule SwitchSceneApplied {
    when: ApplyPending()
    requires: SceneManager.pending != null

    -- Outgoing scene is deactivated; target is built if not yet created, then activated
    ensures: SceneManager.current.status = inactive
    ensures: SceneManager.pending.status = active
    ensures: SceneManager.current = SceneManager.pending
    ensures: SceneManager.pending = null
}

-- Frame progression

rule FrameProcessed {
    when: Frame(dt)
    requires: SceneManager.current != null

    -- Order matters: a switch requested during update takes effect before drawing
    ensures: SceneManager.current.update(dt)
    ensures: ApplyPending()
    ensures: SceneManager.current.draw()
}

-- Open questions (judgement calls not confirmed from code)

open question "Escape is disabled as the exit key and each scene decides what it does. Which scenes handle Escape, and is returning to menu from gameplay the intended behaviour?"
open question "ChangeTo a scene type that was never registered throws. Should this be a requirement that it is always registered, or should the request be ignored?"
open question "RestartCurrent overwrites any switch already queued in the same frame, so the queued change is lost. Intended, or should the queued change win?"
open question "Scene instances are cached, so switching away and back restores their previous state. Is state preservation intended, or should every entry start fresh?"
open question "Outgoing scene's OnExit runs on the old instance even when it is being restarted and discarded. Is that the intended cleanup order?"
open question "Frame(dt) assumes a current scene exists. Before the first switch completes, frames are skipped. Should the spec require a scene to always be active?"
