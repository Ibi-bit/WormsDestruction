<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>My2DGame</RootNamespace>
    <AssemblyName>My2DGame</AssemblyName>
    <Version>0.1.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Pinned to Raylib-cs 7.0.1: rlImgui-cs 3.2.0 (the raylib 7.0 compatible line)
      was built against exactly this version. Letting them float independently
      can pull in a newer raylib whose native ABI no longer matches ImGui's backend.
    -->
    <PackageReference Include="Raylib-cs" Version="7.0.1" />
    <PackageReference Include="rlImgui-cs" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test projects live under tests/ and are built separately. -->
    <Compile Remove="tests/**" />
    <!-- Submodule project build outputs are not game source files. -->
    <Compile Remove="Modules/**/bin/**/*.cs" />
    <Compile Remove="Modules/**/obj/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep assets grouped under Game/ in source while copying them to Content/ at runtime. -->
    <Content Include="Game/Content/**/*"
             Link="Content/%(RecursiveDir)%(Filename)%(Extension)"
             TargetPath="Content/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
